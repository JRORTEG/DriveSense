# Tiger Cloud only -- no local Postgres fallback (see temp/TIGER_CLOUD_SETUP.md).
# Server boots fine with this left as the placeholder; DB logging is just skipped.
TIGER_DATA_DSN=postgresql://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Voice alerts (Task 15, see temp/ELEVENLABS_SETUP.md). Boots fine with this left as
# the placeholder -- voice alerts are just disabled, nothing else breaks.
ELEVENLABS_API_KEY=your_api_key_here
# Optional overrides -- defaults are a stock premade voice + the fast turbo model.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Mac: FastAPI relay bind (Task 10). 0.0.0.0 required so the Windows PC can reach it over LAN.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Mac: log every Nth ingested frame as telemetry instead of every frame (Task 13).
TELEMETRY_FRAME_SAMPLE_N=30

# Windows: point at the Mac's static LAN IP (see README.md "Hardware / Network").
# SERVER_URL=ws://192.168.8.12:8000/ws/ingest

# Windows CV pipeline: webcam index (e.g. 0) or path to a video file; blank TARGET_FPS = native/unthrottled
VIDEO_SOURCE=data/samples/intersection_montreal_720p.webm
TARGET_FPS=
